{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Every *.test.ts / *.test.tsx is type-checked by tsconfig.test.json instead, which adds
     the Node types a filesystem-reading test needs. Keyed on the test EXTENSION rather than
     the __tests__ directory, because tests live beside the code they cover as well as in it -
     src/App.test.tsx and src/components/ExcelHubSection.test.tsx are co-located. Matching
     vitest.config.ts's own globs is what keeps the two from drifting apart. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
